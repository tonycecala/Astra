{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@astra/contracts": ["packages/contracts/src/index.ts"],
      "@astra/db": ["packages/db/src/index.ts"],
      "@astra/db/*": ["packages/db/src/*"],
      "@astra/ui": ["packages/ui/src/index.ts"],
      "@astra/testkit": ["packages/testkit/src/index.ts"],
      "@astra/astrology": ["packages/astrology/src/index.ts"]
    }
  }
}
