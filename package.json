{
  "name": "astra-clean-start",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/astra-web run dev",
    "dev:up": "node --import tsx scripts/dev-server.mts up",
    "dev:status": "node --import tsx scripts/dev-server.mts status",
    "dev:stop": "node --import tsx scripts/dev-server.mts stop",
    "dev:restart": "node --import tsx scripts/dev-server.mts restart",
    "build": "npm --workspace apps/astra-web run build",
    "start": "npm --workspace apps/astra-web run start",
    "composer:dev": "npm --workspace apps/composer-web run dev",
    "composer:up": "node --import tsx scripts/composer-dev-server.mts up",
    "composer:status": "node --import tsx scripts/composer-dev-server.mts status",
    "composer:restart": "node --import tsx scripts/composer-dev-server.mts restart",
    "composer:stop": "node --import tsx scripts/composer-dev-server.mts stop",
    "composer:logs": "node --import tsx scripts/composer-dev-server.mts logs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx scripts/check-foundation.mts",
    "test:auth-code": "node --import tsx scripts/smoke-auth-code.mts",
    "test:auth-profile-concurrency": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/smoke-auth-profile-concurrency.mts",
    "test:email-config": "node --import tsx scripts/smoke-email-config.mts",
    "check:alpha-env": "node --import tsx scripts/check-alpha-deployment-env.mts",
    "alpha:verify-report-continuity": "node --import tsx scripts/verify-alpha-report-continuity.mts",
    "check:composer-alpha-env": "node --import tsx scripts/check-composer-alpha-env.mts",
    "alpha:promote-admin": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/promote-alpha-admin.mts",
    "data:export-user": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/export-user-data.mts",
    "data:import-user": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/import-user-data.mts",
    "data:repair-birth-places": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/repair-birth-place-coordinates.mts",
    "test:user-data-portability": "node --import tsx scripts/smoke-user-data-portability.mts",
    "test:chart-maker": "node --import tsx scripts/smoke-chart-maker.mts",
    "test:chart-boundary": "node --import tsx scripts/smoke-chart-boundary.mts",
    "test:birth-date-time-sheet": "node --import tsx scripts/smoke-birth-date-time-sheet.mts",
    "test:chart-request-api": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/smoke-chart-request-api.mts",
    "test:astrology-engine": "node --import tsx scripts/smoke-astrology-engine.mts",
    "test:ally-api": "node --import tsx scripts/smoke-ally-api.mts",
    "test:report-api": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/smoke-report-api.mts",
    "test:report-basis-contracts": "node --import tsx scripts/smoke-report-basis-contracts.mts",
    "test:report-settings-quality": "node --import tsx scripts/smoke-report-settings-quality.mts",
    "test:report-model-strategy": "node --import tsx scripts/smoke-report-model-strategy.mts",
    "test:report-deep-quality": "node --import tsx scripts/smoke-report-deep-quality.mts",
    "test:report-paragraphs": "node --import tsx scripts/smoke-report-paragraphs.mts",
    "test:report-display-title": "node --import tsx scripts/smoke-report-display-title.mts",
    "test:report-families": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/smoke-report-families.mts",
    "test:tony-deep-sonnet": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/smoke-tony-deep-sonnet.mts",
    "test:stripe-checkout": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/smoke-stripe-checkout.mts",
    "test:stripe-webhook": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/smoke-stripe-webhook-fulfillment.mts",
    "stripe:fulfill-latest": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/fulfill-latest-stripe-checkout.mts",
    "report:bakeoff": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/run-report-v2-model-profile-bakeoff.mts",
    "report:quality-bakeoff": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/run-report-model-quality-bakeoff.mts",
    "report:prompt-bakeoff": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/run-report-prompt-change-bakeoff.mts",
    "report:relationship-context-bakeoff": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/run-report-relationship-context-bakeoff.mts",
    "report:semantic-synthesis-control": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/run-ally-semantic-synthesis-control.mts",
    "report:prompt-compare": "node --import tsx scripts/compare-report-prompt-bakeoff.mts",
    "report:ally-deep-bakeoff": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/run-ally-deep-model-bakeoff.mts",
    "report:compare-deep": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/create-and-compare-deep-report.mts",
    "report:audit-deep-cohort": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/audit-deep-report-cohort.mts",
    "overview:light": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/create-light-mode-overview.mts",
    "overview:chart-flow": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/create-chart-report-flow-map.mts",
    "test:place-search-api": "node --import tsx scripts/smoke-place-search-api.mts",
    "test:place-search-provider": "node --import tsx scripts/test-place-search-provider.mts",
    "test:composer-stream": "node --import tsx scripts/smoke-composer-stream.mts",
    "test:composer-quarry": "node --import tsx scripts/smoke-composer-quarry.mts",
    "test:composer-course-ux": "node --import tsx scripts/smoke-composer-course-ux.mts",
    "test:composer-card-detail": "node --import tsx scripts/smoke-composer-card-detail.mts",
    "test:composer-ingest-api": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/smoke-composer-ingest-api.mts",
    "test:private-feed": "node --import tsx scripts/smoke-private-feed.mts",
    "test:composer-private-feed-api": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/smoke-composer-private-feed-api.mts",
    "test:composer-operator-workflow": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/smoke-composer-operator-workflow.mts",
    "test:composer-card-queue-api": "node --import tsx scripts/smoke-composer-card-queue-api.mts",
    "test:composer-availability-api": "node --import tsx scripts/smoke-composer-availability-api.mts",
    "test:composer-selection-api": "node --import tsx scripts/smoke-composer-selection-api.mts",
    "test:composer-public-preview": "node --import tsx scripts/smoke-public-composer-preview.mts",
    "test:composer-hosted-boundary": "node --import tsx scripts/smoke-composer-hosted-boundary.mts",
    "test:composer-onboarding-cards": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/smoke-composer-onboarding-cards.mts",
    "test:composer-onboarding-mobile": "node --env-file-if-exists=apps/astra-web/.env.local --import tsx scripts/smoke-composer-onboarding-mobile.mts",
    "test:e2e": "node --env-file-if-exists=apps/astra-web/.env.local node_modules/@playwright/test/cli.js test --config apps/astra-web/playwright.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:boundaries && npm run check:no-supabase && npm run build",
    "check:boundaries": "node --import tsx scripts/check-boundaries.mts",
    "check:no-supabase": "node --import tsx scripts/check-no-supabase.mts",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config packages/db/drizzle.config.ts",
    "db:reset:local": "node --import tsx scripts/reset-local-db.mts",
    "db:seed": "node --import tsx scripts/seed-db.mts",
    "db:seed:private-card": "node --import tsx scripts/seed-private-journey-card.mts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.11",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "nodemailer": "^8.0.10",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.12.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}
