import assert from "node:assert/strict";
import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { astrologyReportRequestSchema } from "@astra/contracts";
import { inspectPortraitsV4Cohort } from "./portraits-v4-inspection";

const root = mkdtempSync(join(tmpdir(), "astra-v4-inspection-"));
const birthData = { date: "1990-04-05", time: "09:00", timezone: "America/New_York", latitude: 40.7, longitude: -74, location: "New York", birthTimeKnown: true };
const input = astrologyReportRequestSchema.parse({ id: "req-fixture", userId: "fixture-user", reportType: "personal", subjectName: "Fixture Reader", birthData, status: "queued", source: "self", createdAt: "2026-09-18T00:00:00Z", updatedAt: "2026-09-18T00:00:00Z", reportBasis: { schemaVersion: 2, type: "natal", primary: { chartRequestId: "chart-fixture", subjectType: "self", subjectName: "Fixture Reader", birthData, calculationMode: "full" }, chartSettings: { zodiacMode: "tropical", houseSystem: "whole-sign" } } });
const portraitEvidence = [{ id: "P01", topic: "Identity", fact: "symbolic fact", meaning: "symbolic meaning" }];
const result = { id: "report-fixture", requestId: input.id, userId: input.userId, engine: "fixture", engineVersion: "1", status: "completed", sections: [{ id: "section-1", title: "Identity", body: "A present-focused reflection.", emphasis: "primary" }], provenance: [], generationMetadata: { writer: "fixture", model: "fixture-model", promptVersion: "fixture-v1", attemptCount: 1, orchestration: "portraits-v4", portraitsV4: { evidence: portraitEvidence, thread: "A connected thread.", trace: [{ title: "Identity", evidenceIds: ["P01"] }], reviews: [{ accepted: true, issues: [] }] } }, createdAt: "2026-09-18T00:00:01Z" };
function writeReport(dir: string, request: unknown, report: unknown, evidence: unknown, reading = "## Identity\n\nA present-focused reflection.") { writeFileSync(join(dir, "manifest.json"), JSON.stringify({ cases: [["fixture", "personal"]] })); writeFileSync(join(dir, "R-fixture.input.json"), JSON.stringify(request)); writeFileSync(join(dir, "R-fixture.result.json"), JSON.stringify(report)); writeFileSync(join(dir, "R-fixture.reading.md"), reading); writeFileSync(join(dir, "R-fixture.evidence.json"), JSON.stringify(evidence)); }
function make(name: string, mutate: (dir: string) => void = () => {}) { const dir = join(root, name); mkdirSync(dir); writeReport(dir, input, result, { topic: "personal", reader: "Fixture Reader", evidence: portraitEvidence }); mutate(dir); return dir; }
let report = inspectPortraitsV4Cohort(make("success")); assert.equal(report.status, "PASS"); assert.equal(report.counts.completed, 1); assert.equal(report.counts.words, 3);
report = inspectPortraitsV4Cohort(make("missing", (dir) => rmSync(join(dir, "R-fixture.result.json")))); assert.equal(report.status, "INCOMPLETE"); assert(report.findings.some((item) => item.code === "MISSING_RESULT"));
report = inspectPortraitsV4Cohort(make("mismatch", (dir) => writeFileSync(join(dir, "R-fixture.result.json"), JSON.stringify({ ...result, requestId: "other" })))); assert(report.findings.some((item) => item.code === "REQUEST_ID_MISMATCH"));
report = inspectPortraitsV4Cohort(make("failed", (dir) => { const failed = { ...result, status: "failed", sections: [], error: "fixture failure", generationMetadata: { ...result.generationMetadata, portraitsV4: undefined } }; writeFileSync(join(dir, "R-fixture.result.json"), JSON.stringify(failed)); writeFileSync(join(dir, "R-fixture.reading.md"), "Generation did not complete: fixture failure"); })); assert.equal(report.counts.failed, 1); assert.equal(report.status, "FAIL");
report = inspectPortraitsV4Cohort(make("privacy", (dir) => writeFileSync(join(dir, "R-fixture.result.json"), JSON.stringify({ ...result, sections: [{ ...result.sections[0], body: "Fixture Reader req-fixture P01" }] })))); assert(report.findings.some((item) => item.code === "VISIBLE_PRIVACY_LEAK"));
report = inspectPortraitsV4Cohort(make("evidence-mutation", (dir) => writeFileSync(join(dir, "R-fixture.evidence.json"), JSON.stringify({ topic: "personal", reader: "Fixture Reader", evidence: [] })))); assert(report.findings.some((item) => item.code === "EVIDENCE_CONTENT"));
report = inspectPortraitsV4Cohort(make("advisory", (dir) => { const advisoryResult = { ...result, sections: [{ ...result.sections[0], body: "A hard-won self-protection that learned early to be careful." }] }; writeFileSync(join(dir, "R-fixture.result.json"), JSON.stringify(advisoryResult)); writeFileSync(join(dir, "R-fixture.reading.md"), "## Identity\n\nA hard-won self-protection that learned early to be careful."); })); assert.equal(report.status, "PASS"); assert(report.advisories.some((item) => item.code === "ORIGIN_ADVISORY"));
const tone = { policyVersion: "ally-tone-v1", authoredRelationship: "Friend", normalizedTag: "Friend", structuralLens: "friendship", romanticLanguage: "prohibit" };
const synInput = astrologyReportRequestSchema.parse({ ...input, id: "req-syn-fixture", reportType: "synastry", context: { synastryTone: tone }, reportBasis: { ...input.reportBasis, type: "synastry", partner: { chartRequestId: "partner-chart", subjectType: "ally", subjectName: "Fixture Partner", birthData, calculationMode: "full" } } });
const synEvidence = [{ id: "S01", label: "Connection", meaning: "A symbolic connection.", evidenceJobs: ["connection"] }];
const synMetadata = { schemaVersion: 1, sourceReportIds: [], tone, evidenceIndex: synEvidence, chapterTrace: Array.from({ length: 6 }, (_, index) => ({ chapter: `Chapter ${index + 1}`, evidenceIds: ["S01"], supportedFeeling: "A supported feeling." })), validation: { wordCount: 1500, acceptedWordRange: { minimum: 1350, maximum: 1650 }, boundaryViolations: [], fatalCategories: [], reviewNotes: [], greenLight: true } };
const synResult = { ...result, requestId: synInput.id, generationMetadata: { writer: "fixture", model: "fixture-model", promptVersion: "synastry-v1", attemptCount: 1, orchestration: "synastry-v3", synastryV3: synMetadata } };
const synDir = join(root, "synastry"); mkdirSync(synDir); writeReport(synDir, synInput, synResult, { topic: "synastry", reader: "Fixture Reader", partner: "Fixture Partner", relationship: "Friend", evidence: synEvidence }); report = inspectPortraitsV4Cohort(synDir); assert.equal(report.status, "PASS");
const synMissingDir = join(root, "synastry-missing-metadata"); mkdirSync(synMissingDir); writeReport(synMissingDir, synInput, { ...synResult, generationMetadata: { ...synResult.generationMetadata, synastryV3: undefined } }, { topic: "synastry", reader: "Fixture Reader", partner: "Fixture Partner", relationship: "Friend", evidence: synEvidence }); report = inspectPortraitsV4Cohort(synMissingDir); assert(report.findings.some((item) => item.code === "SYNASTRY_METADATA_MISSING"));
const synLeakDir = join(root, "synastry-leak"); mkdirSync(synLeakDir); writeReport(synLeakDir, synInput, { ...synResult, sections: [{ ...result.sections[0], body: "A present-focused req-syn-fixture reflection." }] }, { topic: "synastry", reader: "Fixture Reader", partner: "Fixture Partner", relationship: "Friend", evidence: synEvidence }); report = inspectPortraitsV4Cohort(synLeakDir); assert(report.findings.some((item) => item.code === "VISIBLE_PRIVACY_LEAK"));
const synRelationshipDir = join(root, "synastry-relationship"); mkdirSync(synRelationshipDir); writeReport(synRelationshipDir, synInput, synResult, { topic: "synastry", reader: "Fixture Reader", partner: "Fixture Partner", relationship: "Sibling", evidence: synEvidence }); report = inspectPortraitsV4Cohort(synRelationshipDir); assert(report.findings.some((item) => item.code === "EVIDENCE_RELATIONSHIP"));
const nullManifestDir = join(root, "null-manifest"); mkdirSync(nullManifestDir); writeFileSync(join(nullManifestDir, "manifest.json"), "null"); report = inspectPortraitsV4Cohort(nullManifestDir); assert.equal(report.status, "FAIL"); assert(report.findings.some((item) => item.code === "MANIFEST_MISSING_OR_MALFORMED"));
console.log("PASS offline V4 inspector fixtures: success, incomplete, mismatch, failed, privacy, evidence, advisory, Synastry, null manifest."); rmSync(root, { recursive: true, force: true });
